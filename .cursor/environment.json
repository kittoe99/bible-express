{
  "name": "Bible Xpress (Flutter web)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "flutter pub get",
  "terminals": [
    {
      "name": "flutter-web",
      "command": "flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080"
    }
  ],
  "ports": [8080]
}
